# Dependencies and package manager caches; keep lockfiles.
node_modules/
.pnp
.pnp.*
.npm/
.pnpm-store/

# Local environment and credentials; keep configuration templates.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
*.key
*.pem
*.p12
*.pfx

# Generated builds and caches, including custom NEXT_BUILD_DIR directories.
.next/
.next-*/
dist/
build/
out/
next-env.d.ts
*.tsbuildinfo
.cache/
.eslintcache
.stylelintcache
.husky/_/

# Generated reports and screenshots; keep tests, e2e and fixtures.
coverage/
.nyc_output/
.playwright-results/
test-results/
tests-results/
playwright-report/
blob-report/
ui-artifacts/

# Logs and temporary files.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/
/temp/
*.tmp
*.bak
*.swp
*.swo
*~

# Editor and operating system files; keep shared editor settings.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
NUL
